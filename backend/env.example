# Application Configuration
APP_NAME=sllm-pattern
SERVER_PORT=9502
API_HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://postgres:test1234@127.0.0.1:5433/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=test1234

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11435
MODEL_NAME=exaone3.5-2.4
MODEL_PATH=./models/exaone3.5-2.4

# Web Search Engine Configuration
# Options: duckduckgo (free, no API key needed), google, serpapi
SEARCH_ENGINE=duckduckgo

# Google Search API Configuration (only needed if using Google)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# SerpAPI Configuration (only needed if using SerpAPI)
SERPAPI_KEY=your_serpapi_key_here

# Logging Configuration
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SERVICE=INFO
LOG_LEVEL_OLLAMA=INFO
LOG_LEVEL_VECTORSTORE=INFO
